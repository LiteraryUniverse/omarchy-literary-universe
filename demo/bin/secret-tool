#!/bin/sh
# Demo keyring: a fake credential for this plugin only; everything else goes to the real tool.
case " $* " in
  *" literary-universe-omarchy "*)
    [ "$1" = lookup ] && printf '%s' '{"accessToken":"demo","refreshToken":"demo","clientId":"demo","expiresAt":4102444800000}'
    [ "$1" = store ] && cat >/dev/null
    exit 0 ;;
  " --help ") exit 2 ;;
esac
exec /usr/bin/secret-tool "$@"
