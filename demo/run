#!/bin/bash
# Capture preview.png from a demo shell fed by fictional fixtures, then restore
# the normal shell, the installed plugin and the workspace.
#
#   demo/run [output.png]
#
# Stops the running Omarchy shell for about half a minute. The demo shell loads
# this checkout's HEAD, reads demo/fixtures through a loopback server and uses
# the demo/bin keyring shim, so no real account or credential is involved.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
id=literaryuniverse.companion
config=${OMARCHY_PATH:-/usr/share/omarchy}/shell
plugin=$HOME/.config/omarchy/plugins/$id
out=$(realpath -m "${1:-$repo/preview.png}")

for command in quickshell omarchy-shell omarchy-restart-shell omarchy-hyprland-session-locked hyprctl grim jq node git tar; do
  command -v "$command" >/dev/null || { echo "Missing $command" >&2; exit 1; }
done
[[ -f $config/shell.qml ]] || { echo "No Omarchy shell at $config" >&2; exit 1; }
if omarchy-hyprland-session-locked; then echo "Session is locked" >&2; exit 1; fi
[[ -z $(git -C "$repo" status --porcelain) ]] || { echo "Commit first: the demo loads HEAD" >&2; exit 1; }

work=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/lu-demo.XXXXXX")
workspace=$(hyprctl activeworkspace -j | jq -r .id)
moved=0 created=0 server=""

restore() {
  local status=$?
  set +e
  [[ -n $server ]] && kill "$server" 2>/dev/null
  if (( created )); then rm -rf -- "$plugin"; fi
  if (( moved )); then mv -- "$work/installed" "$plugin" || { echo "Installed plugin left at $work/installed" >&2; exit 1; }; fi
  omarchy-restart-shell || echo "Run omarchy restart shell" >&2
  hyprctl dispatch "hl.dsp.focus({ workspace = \"$workspace\" })" >/dev/null
  [[ -n ${base:-} ]] && rm -rf -- "$(node --input-type=module -e "import { stateDirectory } from '$repo/src/state.mjs'; console.log(stateDirectory('$base'))")"
  if (( status == 0 )); then rm -rf -- "$work"; else echo "Demo failed; logs in $work" >&2; fi
  exit "$status"
}
trap restore EXIT
trap 'exit 130' INT TERM HUP

node "$repo/demo/server.mjs" "$work/requests" >"$work/server" &
server=$!
for _ in $(seq 50); do [[ -s $work/server ]] && break; sleep 0.1; done
base=$(head -1 "$work/server")
[[ $base == http://127.0.0.1:* ]] || { echo "Fixture server did not start" >&2; exit 1; }

# Same stop as omarchy-restart-shell: kill until none answers, then wait for teardown (-n refuses a second instance).
while timeout 30 quickshell kill -p "$config" --any-display >/dev/null 2>&1; do :; done
for _ in $(seq 300); do quickshell list -a -j 2>/dev/null | jq -e --arg d "$config/" 'any(.[]; .config_path | startswith($d))' >/dev/null || break; sleep 0.1; done
if [[ -e $plugin ]]; then mv -- "$plugin" "$work/installed"; moved=1; fi
mkdir -- "$plugin"; created=1
git -C "$repo" archive HEAD | tar -x -C "$plugin"

PATH="$repo/demo/bin:$PATH" LU_COMPANION_URL=$base QS_DISABLE_FILE_WATCHER=1 QS_NO_RELOAD_POPUP=1 \
  setsid -f quickshell -n -p "$config" >"$work/shell.log" 2>&1
for _ in $(seq 600); do OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell shell ping >/dev/null 2>&1 && break; sleep 0.1; done

# An unused workspace keeps windows out of the frame.
empty=$(( $(hyprctl workspaces -j | jq '[.[].id] | max') + 1 ))
hyprctl dispatch "hl.dsp.focus({ workspace = \"$empty\" })" >/dev/null
omarchy-shell shell toggle "$id" '{}' >/dev/null
for _ in $(seq 100); do grep -qx /article "$work/requests" 2>/dev/null && break; sleep 0.1; done
grep -qx /article "$work/requests" || { echo "The panel never refreshed from the fixtures" >&2; exit 1; }
sleep 1 # let the panel grow to fit the loaded content

hyprctl layers -j >"$work/layers.json"
monitor=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')
geometry=$(jq -r --arg m "$monitor" '.[$m].levels[][] | select(.namespace | test("keyboard|panel|popup"; "i")) | "\(.x),\(.y) \(.w)x\(.h)"' "$work/layers.json" | tail -1)
[[ -n ${DEMO_DEBUG:-} ]] && { cp "$work/layers.json" "$DEMO_DEBUG/"; grim -o "$monitor" "$DEMO_DEBUG/full.png"; }
if [[ -n $geometry ]]; then grim -g "$geometry" "$out"; else grim -o "$monitor" "$out"; fi
echo "Captured $out ($monitor ${geometry:-full output})"
